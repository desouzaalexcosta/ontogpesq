[ rdf:type owl:AllDisjointClasses ] owl:members (:Equipamento :Laboratorio).
:ProjetoDePesquisa owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:ProjetoAtivo :ProjetoPlanejado :ProjetoCancelado :ProjetoConcluido)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:BolsaPesquisador :BolsaMestrado :BolsaDoutorado).
[ rdf:type owl:AllDisjointClasses ] owl:members (:ObjetivoDesenvolvimentoSustentavel :ObjetivoPoliticaPublica :MetaInstitucional).
[ rdf:type owl:AllDisjointClasses ] owl:members (:Custeio :Capital).
:financiadoPor owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Custeio :Capital)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:ProdutoTecnicoTecnologico :ProducaoBibliografica :ProducaoArtistica :TrabalhoConclusaoCurso).
:ProducaoAcademica owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:ProdutoTecnicoTecnologico :ProducaoBibliografica :ProducaoArtistica :TrabalhoConclusaoCurso)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Livro :ArtigoDePeriodico :TrabalhoEmEvento).
[ rdf:type owl:AllDisjointClasses ] owl:members (:TeseDoutorado :DissertacaoMestrado).
:TrabalhoConclusaoCurso owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:TeseDoutorado :DissertacaoMestrado)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Patente :Software).
[ rdf:type owl:AllDisjointClasses ] owl:members (:ArtesVisuais :Musica).
