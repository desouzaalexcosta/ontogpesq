[ rdf:type owl:AllDisjointClasses ] owl:members (:Laboratorio :Equipamento).
:ProjetoDePesquisa owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:ProjetoCancelado :ProjetoAtivo :ProjetoConcluido :ProjetoPlanejado)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:BolsaDoutorado :BolsaMestrado :BolsaPesquisador).
[ rdf:type owl:AllDisjointClasses ] owl:members (:MetaInstitucional :ObjetivoPoliticaPublica :ObjetivoDesenvolvimentoSustentavel).
[ rdf:type owl:AllDisjointClasses ] owl:members (:Capital :Custeio).
:financiadoPor owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:Capital :Custeio)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:TrabalhoConclusaoCurso :ProducaoArtistica :ProdutoTecnicoTecnologico :ProducaoBibliografica).
:ProducaoAcademica owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:TrabalhoConclusaoCurso :ProducaoArtistica :ProdutoTecnicoTecnologico :ProducaoBibliografica)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:TrabalhoEmEvento :ArtigoDePeriodico :Livro).
[ rdf:type owl:AllDisjointClasses ] owl:members (:DissertacaoMestrado :TeseDoutorado).
:TrabalhoConclusaoCurso owl:equivalentClass [
  rdf:type owl:Class;
  owl:unionOf (:DissertacaoMestrado :TeseDoutorado)
].
[ rdf:type owl:AllDisjointClasses ] owl:members (:Software :Patente).
[ rdf:type owl:AllDisjointClasses ] owl:members (:ArtesVisuais :Musica).
