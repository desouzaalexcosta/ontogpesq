  owl:onClass :InstituicaoDeEnsinoSuperior
].
:DocentePosGraduacao rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty [ owl:inverseOf gufo:mediates ];
  owl:someValuesFrom :VinculoInstitucional
].
:VinculoInstitucional rdfs:subClassOf [
  rdf:type owl:Restriction;
