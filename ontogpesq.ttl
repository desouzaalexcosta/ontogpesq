# ---------------------------------------------------------------------------
# Acrescentado em pos-processamento.
# As relacoes «historicalDependence» do modelo conceitual sao declaradas aqui
# como subpropriedades nomeadas de gufo:historicallyDependsOn. O exportador do
# plugin nao as emite quando a multiplicidade da ponta de origem e ilimitada, e
# a cardinalidade nao pode ser imposta diretamente sobre
# gufo:historicallyDependsOn, que nao e propriedade simples.
# ---------------------------------------------------------------------------
:produtoDe rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:historicallyDependsOn;
    rdfs:domain :ProducaoAcademica;
    rdfs:range :ProjetoDePesquisa;
    rdfs:label "produtoDe"@pt-br.

:ProducaoAcademica rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty :produtoDe;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :ProjetoDePesquisa
].

:derivadoDe rdf:type owl:ObjectProperty;
    rdfs:subPropertyOf gufo:historicallyDependsOn;
    rdfs:domain :ProducaoBibliografica;
    rdfs:range :TrabalhoConclusaoCurso;
    rdfs:label "derivadoDe"@pt-br.

:ProducaoBibliografica rdfs:subClassOf [
  rdf:type owl:Restriction;
  owl:onProperty :derivadoDe;
  owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger;
  owl:onClass :TrabalhoConclusaoCurso
].
